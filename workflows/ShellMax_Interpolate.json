{
  "_comment": "Golden API graph for ShellMax frame interpolation (native RIFE / FILM).",
  "1": {
    "class_type": "VHS_LoadVideoPath",
    "inputs": {
      "video": "__SOURCE__",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None"
    }
  },
  "2": {
    "class_type": "ShellMaxFrameInterpLoaderByPath",
    "inputs": {
      "model_path": "__MODEL__"
    }
  },
  "3": {
    "class_type": "FrameInterpolate",
    "inputs": {
      "interp_model": ["2", 0],
      "images": ["1", 0],
      "multiplier": 2
    }
  },
  "4": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["3", 0],
      "audio": ["1", 2],
      "filename_prefix": "ShellMax/interpolate",
      "frame_rate": 48.0,
      "loop_count": 0,
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 17,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    }
  }
}
